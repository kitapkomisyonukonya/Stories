{
  "name": "stories-interactive-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:seyahatname && npm run typecheck && npm run validate:content && npm run validate:rules && npm run validate:vocabulary && npm run validate:exercises && vite build && npm run build:panel",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run typecheck",
    "validate": "node scripts/validation/runDeployChecks.mjs --checks-only",
    "validate:deploy": "node scripts/validation/runDeployChecks.mjs",
    "validate:bundle": "tsx scripts/validation/validateBundle.ts",
    "audit:media": "tsx scripts/validation/auditStorageMedia.ts",
    "inventory:storage": "tsx scripts/validation/exportStorageInventory.ts",
    "validate:vocabulary": "tsx scripts/validation/validateVocabularyFlow.ts",
    "validate:exercises": "tsx scripts/validation/validateExerciseStructure.ts",
    "format": "prettier --write e2e playwright.config.ts eslint.config.js",
    "format:check": "prettier --check e2e playwright.config.ts eslint.config.js",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:unit": "node --test tests/*.test.mjs",
    "validate:content": "tsx scripts/validation/validateContentFiles.ts",
    "validate:rules": "tsx scripts/validation/validateContentRules.ts",
    "build:panel": "vite build --config vite.panel.config.ts && tsx scripts/content/buildPanelData.ts",
    "report:content": "tsx scripts/validation/contentHealth.ts",
    "build:seyahatname": "tsx scripts/content/buildSeyahatname.ts"
  },
  "dependencies": {
    "@firebase/app": "^0.15.1",
    "@firebase/auth": "1.13.6",
    "@firebase/storage": "^0.14.5",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "google-auth-library": "^10.9.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.2.0"
  }
}
